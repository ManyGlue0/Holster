{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Holster",
  "version": "0.2.5",
  "identifier": "app.holster.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Holster",
        "url": "index.html",
        "width": 14,
        "height": 88,
        "minWidth": 1,
        "minHeight": 1,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "focus": false,
        "shadow": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "frame-src": "http://127.0.0.1:*"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "A dock on the edge of your screen for your own apps",
    "longDescription": "Holster lives on the edge of your screen as a slim tab and opens into a dock for your own tools.",
    "windows": {
      "nsis": { "installMode": "currentUser", "installerIcon": "icons/icon.ico" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGN0U0N0JDNUY0Q0E1QjEKUldTeHBVeGZ2RWQrcnd3UmpUWEZ1RGVlRUo1OWZGSzJpU2lDVW1xSHRVTTk4Z3ptRnp4UGN1MUwK",
      "endpoints": ["https://github.com/ManyGlue0/Holster/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
